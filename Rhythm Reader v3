<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🥁</text></svg>">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f5f7fc;--fg:#15203b;--mu:#65718a;--soft:#edf1f8;--card:#fff;--ac:#315bea;--ac2:#6c7ff2;--acf:#fff;--bd:#dfe5f0;--warn:#f0a51a;--shadow:0 18px 50px rgba(24,39,75,.08)}
